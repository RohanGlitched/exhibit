# PayPal sandbox REST app (Merchant), tied to a US sandbox business account.
# Features: Customer disputes, Transaction search. Card payments must be enabled for the account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The model that argues cases (Azure OpenAI Responses API). Without it, the rules engine argues instead.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.6
AZURE_OPENAI_REASONING=low
AZURE_OPENAI_MODEL_LABEL=GPT-5.6 on Azure OpenAI

# Optional: Amazon Bedrock instead of Azure (Claude Haiku 4.5).
# AWS_BEARER_TOKEN_BEDROCK=

# Exhibit's case notes: Google Cloud Storage, keyless through Vercel OIDC and a workload identity pool
# (or a base64 service-account key in GCS_SA_KEY). Without them, and always on a dev server, they go to .data/.
# PayPal's own record stays the source of truth for where a case stands.
GCS_BUCKET=
GCS_WIF_AUDIENCE=

# Agent stories: the Ed25519 keys that sign agent mandates. The wallet key signs the cardholder's intent; the agent
# key signs the cart the buyer's agent pays for. Each is a base64 PKCS#8 DER private key (PEM works too). Make one with:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
# Their public keys are published at /.well-known/exhibit-keys.json, and every mandate is verified against the key
# found there by kid. Keep them stable: a mandate signed with a key you rotate away no longer verifies.
# Without them a dev server makes a pair once in .data/keys/ (ignored by git), and production can't open agent stories.
EXHIBIT_WALLET_SIGNING_KEY=
EXHIBIT_AGENT_SIGNING_KEY=

# Optional: an AG Studio trial or licence key removes the evaluation watermark on /desk/analytics.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# Protects POST /api/pool (the pool refill cron).
CRON_SECRET=
DAILY_MODEL_CAP=400
NEXT_PUBLIC_SITE_URL=http://localhost:3600
